{
  "name": "augment-poker",
  "productName": "Augment Poker",
  "description": "리그 오브 레전드식 증강을 더한 텍사스 홀덤",
  "author": "chagyuhwan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "simulate": "npx -y tsx scripts/simulate.ts",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win dir",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "build": {
    "appId": "com.chagyuhwan.augmentpoker",
    "productName": "Augment Poker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": "dir",
      "executableName": "AugmentPoker"
    },
    "linux": {
      "target": "dir",
      "executableName": "augment-poker",
      "category": "Game"
    }
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
